<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/newOutfitScrollView"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/navigation_top"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/back"
                android:layout_margin="10dp"
                android:padding="5dp"
                android:elevation="5dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_shape"
                android:src="@drawable/round_arrow_back_24"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Your Outfit"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="One-Piece Outfit"
                android:textSize="18sp"
                android:fontFamily="@font/roboto"
                android:layout_weight="1"
                android:layout_marginStart="5dp"/>

            <Switch
                android:id="@+id/switchOnePiece"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:textOff=""
                android:textOn=""/>


        </LinearLayout>

        <!-- Accessories Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessory"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>

                <CheckBox
                    android:id="@+id/chkSecondAccessory"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Add Accessory"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgAccessory1"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Accessory 1"
                android:clipToOutline="true"/>

            <ImageView
                android:id="@+id/imgAccessory2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:layout_marginStart="10dp"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Accessory 2"
                android:visibility="invisible"
                android:clipToOutline="true"/>





        </LinearLayout>
        <TextView
            android:id="@+id/tvWarningAccessory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Select an image for the first accessory!"
            android:textSize="16sp"
            android:textColor="@color/red"
            android:drawableStart="@drawable/outline_info_24"
            android:drawablePadding="5dp"
            android:drawableTint="@color/red"
            android:padding="8dp"
            android:alpha="1.0"
            android:visibility="gone"/>


        <!-- Outerwear Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outerwear"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgOuterwear"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Outwear"
                android:clipToOutline="true"/>

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:visibility="invisible"
                android:layout_marginStart="10dp"
                />
        </LinearLayout>

        <!-- Tops Section -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>

                <CheckBox
                    android:id="@+id/chkSecondLayer"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Add Layer"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgTop1"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Top 1"
                android:clipToOutline="true"/>

            <ImageView
                android:id="@+id/imgTop2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:layout_marginStart="10dp"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Top 2"
                android:visibility="invisible"
                android:clipToOutline="true"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvWarningTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Select an image for the first top!"
            android:textSize="16sp"
            android:textColor="@color/red"
            android:drawableStart="@drawable/outline_info_24"
            android:drawablePadding="5dp"
            android:drawableTint="@color/red"
            android:padding="8dp"
            android:alpha="1.0"
            android:visibility="gone"/>

        <!-- Bottom Section -->
        <LinearLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bottom"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgBottom"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Bottom"
                android:clipToOutline="true"/>

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:visibility="invisible"
                android:layout_marginStart="10dp"
                />

        </LinearLayout>

        <!-- One-Piece Section -->
        <LinearLayout
            android:id="@+id/onePieceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One-Piece"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>

                <CheckBox
                    android:id="@+id/chkLayerOnePiece"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_margin="5dp"
                    android:text="Add Layer"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgOnePiece"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="One-Piece"
                android:clipToOutline="true"/>

            <ImageView
                android:id="@+id/imgLayerOnePiece"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:layout_marginStart="10dp"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Top Layer"
                android:visibility="invisible"
                android:clipToOutline="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvWarningOnePiece"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Select an image for the one-piece first!"
            android:textSize="16sp"
            android:textColor="@color/red"
            android:drawableStart="@drawable/outline_info_24"
            android:drawablePadding="5dp"
            android:drawableTint="@color/red"
            android:padding="8dp"
            android:alpha="1.0"
            android:visibility="gone"/>

        <!-- Shoes Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shoes"
                    android:layout_margin="5dp"
                    android:textSize="20dp"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgShoes"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/round_add_24"
                android:background="@drawable/dashed_border"
                android:scaleType="centerCrop"
                android:contentDescription="Shoes"
                android:clipToOutline="true"/>

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:visibility="invisible"
                android:layout_marginStart="10dp"
                />
        </LinearLayout>



        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addOutfitBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/edittextshape"
            android:backgroundTint="@color/blue"
            android:text="SAVE OUTFIT"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto"
            android:textStyle="bold"
            android:layout_margin="30dp"/>
    </LinearLayout>
</ScrollView>
