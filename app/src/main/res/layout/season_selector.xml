<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seasonGrid"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alignmentMode="alignMargins"
    android:columnCount="2"
    android:rowCount="2"
    android:useDefaultMargins="true"
    android:padding="12dp">

    <!-- Spring -->
    <LinearLayout
        android:id="@+id/seasonSpring"
        style="@style/SeasonItemStyle"
        android:tag="spring">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/round_favorite_border_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spring"
            android:paddingTop="8dp"
            android:fontFamily="@font/roboto"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Summer -->
    <LinearLayout
        android:id="@+id/seasonSummer"
        style="@style/SeasonItemStyle"
        android:tag="summer">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/round_favorite_border_24"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summer"
            android:paddingTop="8dp"
            android:fontFamily="@font/roboto"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Autumn -->
    <LinearLayout
        android:id="@+id/seasonAutumn"
        style="@style/SeasonItemStyle"
        android:tag="autumn">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/round_favorite_border_24"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autumn"
            android:paddingTop="8dp"
            android:fontFamily="@font/roboto"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Winter -->
    <LinearLayout
        android:id="@+id/seasonWinter"
        style="@style/SeasonItemStyle"
        android:tag="winter">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/round_favorite_border_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Winter"
            android:paddingTop="8dp"
            android:fontFamily="@font/roboto"
            android:textStyle="bold"/>
    </LinearLayout>
</GridLayout>